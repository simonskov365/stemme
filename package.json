{
  "name": "stemme-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.10.0 <25"
  },
  "scripts": {
    "dev": "node --use-env-proxy --env-file-if-exists=.env --watch --import tsx src/server.ts",
    "start": "node --use-env-proxy --env-file-if-exists=.env dist/server.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-isolation=none tests/*.test.ts",
    "test:ui": "node --import tsx --test --test-isolation=none tests/browser/*.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@msgpack/msgpack": "^3.1.3",
    "fastify": "^5.0.0",
    "groq-sdk": "^0.37.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "playwright-core": "^1.64.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
