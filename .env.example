# Node.js 24. Copy to .env; never commit actual credentials.
HOST=127.0.0.1
PORT=3000
# Optional locally; required for any non-loopback binding. Generate at least 32 random characters.
# API_TOKEN=
OWNER_ID=local-user
# Set these two together. Without them, storage/health work but text requests return 503.
# GROQ_API_KEY=
# GROQ_MODEL=
# Microphone transcription uses the existing Groq key.
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
TRANSCRIPTION_MAX_BYTES=8388608
SPEECH_ENABLED=false
# Required together when SPEECH_ENABLED=true:
# FISH_API_KEY=
# FISH_MODEL=
# FISH_VOICE_ID=
DATABASE_PATH=data/stemme.sqlite
ALLOWED_ORIGINS=http://localhost:5173
REQUEST_TIMEOUT_MS=60000
CONTEXT_TOKENS=8192
OUTPUT_TOKENS=1024
AUDIO_TTL_SECONDS=300
LOG_LEVEL=info
ENABLED_TOOLS=
ASSISTANT_NAME=Stemme
SYSTEM_INSTRUCTIONS_FILE=assistant.md
